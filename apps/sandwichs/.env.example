# Copy to .env.local for local development. None of these are required locally:
# without DATABASE_URL the app uses an embedded Postgres (PGlite) in .data/,
# the admin password defaults to "admin", and emails are printed in the terminal.

# Neon Postgres (set automatically on Vercel by the Neon integration)
DATABASE_URL=

# Bruno's admin area (/admin)
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (openssl rand -base64 32)
SESSION_SECRET=

# Emails (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Suricate <commandes@example.fr>"
# Where customer replies go (Bruno's email)
EMAIL_REPLY_TO=

# Public URL used in emails (defaults to the Vercel production URL)
SITE_URL=
