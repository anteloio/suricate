# Copy to .env.local for local development. None of these are required locally:
# without DATABASE_URL the app uses an embedded Postgres (PGlite) in .data/,
# and the admin password defaults to "admin".

# Neon Postgres (set automatically on Vercel by the Neon integration)
DATABASE_URL=

# Bruno's admin area (/admin)
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (openssl rand -base64 32)
SESSION_SECRET=

# SumUp online payments (SumUp dashboard → Paramètres → Développeurs → Clés API).
# Leave empty locally: payments are then simulated. To try real test payments, use the keys of
# the "Suricate Sandbox" merchant (1Password: "SumUp API - Suricate Sandbox"); the test cards
# are listed at https://developer.sumup.com/online-payments/testing
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
