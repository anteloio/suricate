# Copy to .env.local for local development. None of these are required locally:
# without DATABASE_URL the app uses an embedded Postgres (PGlite) in .data/,
# and the admin password defaults to "admin".

# Neon Postgres (set automatically on Vercel by the Neon integration)
DATABASE_URL=

# Bruno's admin area (/admin)
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (openssl rand -base64 32)
SESSION_SECRET=
